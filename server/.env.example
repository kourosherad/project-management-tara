# ---- Server ----
PORT=4000
# Secret used to sign login session tokens (JWT). Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tara_pm

# ---- Local GitLab ----
# Base URL of your in-company GitLab server (no trailing /api).
GITLAB_URL=http://172.30.207.51
# Personal Access Token with `api` scope. Create at: GitLab > User Settings > Access Tokens
GITLAB_TOKEN=

# ---- Claude AI (local CLI) ----
# Command used to invoke Claude. Usually just "claude" if it is on PATH.
# On Windows you may need the full path, e.g. C:\\Users\\you\\AppData\\Roaming\\npm\\claude.cmd
CLAUDE_CLI=claude
# Optional model override passed to the CLI (leave blank to use the CLI default)
CLAUDE_MODEL=
